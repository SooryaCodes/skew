# ---- Alpaca (paper only) ----
# From the DEDICATED hackathon paper account. Not your personal account.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Startup asserts this contains "paper". Do not change it.

# ---- Anthropic (bounded selector model) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Runtime ----
UNIVERSE=SPY,QQQ,IWM,AAPL,MSFT,NVDA,AMD,TSLA
LOOP_INTERVAL_SECONDS=300
DATABASE_URL=sqlite:///./skew.db

# ---- Risk authority ----
RISK_TIER_START=0
MAX_CONCURRENT_POSITIONS=3
KILL_SWITCH=false

# ---- Frontend ----
NEXT_PUBLIC_API_BASE=http://localhost:8000
