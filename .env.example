# ---- Alpaca (paper only) ----
# From the DEDICATED hackathon paper account. Not your personal account.
# Requires Options Level 3 — verify with: python -m skew.cli account
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Startup REFUSES to run if this does not contain "paper". Do not change it.
# There is no live-trading code path anywhere in this repository.

# Optional: the account number this desk is allowed to trade. When set, startup
# verifies the connected account matches, so a stray key cannot trade elsewhere.
ALPACA_ACCOUNT_NUMBER=
EXPECTED_EQUITY=100000

# ---- Anthropic (bounded selector model) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Runtime ----
UNIVERSE=SPY,QQQ,IWM,AAPL,MSFT,NVDA,AMD,TSLA
LOOP_INTERVAL_SECONDS=300
IV_POLL_INTERVAL_SECONDS=300
DATABASE_URL=sqlite:///./skew.db

# The API process runs the trading loop, because the loop needs a persistent
# process. AUTO_EXECUTE off means it scans, gates and logs every cycle but
# submits nothing — turn it on deliberately.
RUN_SCHEDULER=true
AUTO_EXECUTE=false

# ---- Risk authority ----
RISK_TIER_START=0
MAX_CONCURRENT_POSITIONS=3
KILL_SWITCH=false

# ---- Strategy ----
# VRP thresholds in vol points: IV must exceed RV by this much to sell premium.
VRP_SELL_FLOOR=4.0
VRP_BUY_CEILING=-2.0
TARGET_DTE_MIN=21
TARGET_DTE_MAX=45
SHORT_LEG_DELTA_TARGET=0.25
# Strike width as a fraction of spot — ~$5.75 on SPY, ~$1.60 on NVDA. Keeps a
# spread economically the same shape across very different underlyings.
TARGET_WIDTH_PCT=0.0075

# Liquidity floors. Per-contract volume is not available at loop cost, so this
# keys on open interest and bid-ask width; see skew/gates/liquidity.py.
MIN_OPEN_INTEREST=100
MAX_SPREAD_PCT=0.15
MIN_VOLUME=0

# Alpaca serves no earnings calendar. A single name with no confirmed date in
# backend/data/earnings.json is BLOCKED rather than assumed clear. Read
# skew/gates/earnings.py before turning this off.
EARNINGS_BLACKOUT_DAYS=7
EARNINGS_UNKNOWN_BLOCKS=true

# Stress engine. A routine move of ROUTINE_SIGMA must not already reach more
# than ROUTINE_MAX_LOSS_PCT of a short-premium structure's max loss; a long-
# premium structure's breakeven must sit within MAX_BREAKEVEN_SIGMA.
ROUTINE_SIGMA=1.0
ROUTINE_MAX_LOSS_PCT=0.60
MAX_BREAKEVEN_SIGMA=1.25
RISK_FREE_RATE=0.042

# ---- Exits ----
PROFIT_TARGET_PCT=0.50
LOSS_LIMIT_MULTIPLE=2.0
EXIT_DTE_THRESHOLD=7
# Flatten everything before this. ISO-8601, or blank to disable.
DEADLINE_UTC=

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
# Shared secret for the ONLY write endpoint, POST /api/kill. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
CORS_ORIGINS=*
RATE_LIMIT=120/minute

# ---- MCP ----
# When false, execute and close are not registered at all — an accidental
# connection sees a read-only server with nothing to try.
MCP_ALLOW_EXECUTE=false

# ---- Frontend ----
# The only variable that reaches the browser. It is a URL, never a secret.
NEXT_PUBLIC_API_BASE=http://localhost:8000
